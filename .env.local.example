# ============================================
# INA Agro Connect — Production / Local Env
# Copy to .env.local and fill real values
# ============================================

# App
NEXT_PUBLIC_APP_URL=https://inaagroconnect.com

# Chapa (use LIVE keys in production)
# Dashboard: https://dashboard.chapa.co
CHAPA_SECRET_KEY=CHASECK-xxxxxxxxxxxxxxxx
CHAPA_PUBLIC_KEY=CHAPUBK-xxxxxxxxxxxxxxxx

# Resend Email
# Dashboard: https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
EMAIL_FROM=INA Agro Connect <billing@inaagroconnect.com>

# AfroMessage SMS (optional)
# Dashboard: https://afromessage.com
AFROMESSAGE_TOKEN=
AFROMESSAGE_FROM=INAAGRO

# Cron protection
CRON_SECRET=change-me-to-a-long-random-string

# Database (when ready)
# DATABASE_URL=postgresql://user:pass@host:5432/ina_agro
